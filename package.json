{
  "name": "work-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "build": "npm -w apps/web run build",
    "start": "npm -w apps/web run start",
    "test": "npm -w apps/web run test",
    "test:watch": "npm -w apps/web run test:watch",
    "test:coverage": "npm -w apps/web run test:coverage",
    "test:integration": "npm -w apps/web run test:integration",
    "test:e2e": "npm -w apps/web run test:e2e",
    "check-types": "npm -w apps/web run check-types",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:check": "node scripts/check-db.mjs",
    "db:setup": "npm run db:up && node scripts/wait-for-db.mjs && npm run db:push"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
