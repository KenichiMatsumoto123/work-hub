# このファイルを .env にコピーして値を埋める（.env はコミットしない）
# アプリ・drizzle-kit・E2E はいずれも上位ディレクトリを遡ってこの .env を読む

DATABASE_URL=postgres://workhub:workhub_dev@localhost:5432/workhub
POSTGRES_HOST_PORT=5432

# --- ログイン（better-auth + Google OAuth）---

# セッションクッキーの署名に使うシークレット（32文字以上のランダム文字列）
# 例: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# アプリのベースURL（Google に登録するリダイレクトURIと一致させる）
# 本番は https://work-hub.example のような公開URLにする
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud で発行した OAuth 2.0 クライアント（設定手順は docs/google-oauth.md）
# 承認済みのリダイレクトURI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ログインを許可するメールアドレス（カンマ・空白・改行区切り）
# 「@example.com」のようにドメインを書くとそのドメイン全体を許可する
# 未設定の場合は Google アカウントを持つ誰でもログインできてしまうため、公開環境では必ず設定する
AUTH_ALLOWED_EMAILS=you@example.com
